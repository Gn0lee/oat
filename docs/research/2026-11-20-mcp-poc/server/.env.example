# MCP 툴 설계 PoC 서버 설정. .env로 복사해서 채워요(.env는 커밋하지 않아요)
POC_PASSWORD=          # PoC 계정 두 개(me@oat-poc.test, partner@oat-poc.test)의 비밀번호
ADMIN_KEY=             # /poc/admin(앱의 "AI 연결" 화면 자리) 접근 키
BETTER_AUTH_SECRET=    # openssl rand -hex 32
# BASE_URL=https://xxxx.trycloudflare.com   # 임시 터널 주소(없으면 http://localhost:3000)
# CIMD_ORIGIN_BOUND=relaxed                 # client_uri를 도메인 검사에서 빼요(Hermes에 필요)
# CIMD_ALLOW_ALL=1                          # 허용 목록 없이 모든 CIMD 클라이언트를 받아요(관찰용)
# ACCESS_TOKEN_TTL=300                      # 액세스 토큰 수명(초)
